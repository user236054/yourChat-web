rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null && request.auth.token.email in [
        'me@example.com',
        'friend@example.com'
      ];
    }

    function isConversationParticipant() {
      return isAllowedUser() && request.auth.token.email in [
        'me@example.com',
        'friend@example.com'
      ];
    }

    match /conversations/{conversationId} {
      allow get, list: if isAllowedUser();
      allow create: if isAllowedUser() && request.resource.data.participants is list;
      allow update: if isAllowedUser() && (
        request.resource.data.participants == resource.data.participants ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessageId', 'updatedAt', 'typingBy'])
      );
      allow delete: if isAllowedUser();

      match /messages/{messageId} {
        allow get, list, create: if isAllowedUser();
        allow update: if isAllowedUser() &&
          request.auth.token.email == resource.data.senderEmail &&
          request.resource.data.senderEmail == resource.data.senderEmail &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text',
            'editedAt',
            'deletedAt',
            'isDeleted',
            'mediaUrl',
            'mediaType',
            'fileName',
            'status',
            'updatedAt'
          ]);
        allow delete: if isAllowedUser() && request.auth.token.email == resource.data.senderEmail;
      }
    }

    match /users/{userId} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
    }
  }
}
